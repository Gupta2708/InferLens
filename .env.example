APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
INFERLENS_POSTGRES_DB=inferlens
INFERLENS_POSTGRES_USER=inferlens
INFERLENS_POSTGRES_PASSWORD=inferlens
# DATABASE_URL and REDIS_URL are for non-Docker deployments only.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.example.com:5432/postgres
REDIS_URL=redis://redis:6379/0
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_THINKING_BUDGET=0
LLM_MOCK_MODE=false
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4.1-mini
DEFAULT_CONTEXT_WINDOW=8
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PORT=8000
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_BASE_MS=150
PROVIDER_FALLBACKS={}
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
CONTENT_CAPTURE_ENABLED=false
CONTENT_CAPTURE_PREVIEW_LIMIT=500
COMPARISON_MAX_CONCURRENCY=3
WORKER_RETRY_LIMIT=3
WORKER_STALE_CLAIM_MS=60000
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
EXTERNAL_TRACE_URL_TEMPLATE=
